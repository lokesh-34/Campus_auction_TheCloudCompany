# ==========================================
# CampusBid Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# IMPORTANT: Multi-document transactions require a replica set (standalone mongod does not support transactions).
# For local development with a single-node replica set:
# mongod --dbpath <path> --replSet rs0
# URI example: mongodb://localhost:27017/campusbid?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/campusbid?replicaSet=rs0

# Firebase Admin SDK (Backend token verification)
# For local development, set FIREBASE_AUTH_MOCK=true to enable mock auth tokens
FIREBASE_AUTH_MOCK=false
FIREBASE_PROJECT_ID=campusbid-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@campusbid-prod.iam.gserviceaccount.com
# Provide private key with \n escaped or base64 encoded
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Optional alternative: local path to downloaded service account json (kept out of git)
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MAX_FILE_SIZE_BYTES=5242880
MAX_IMAGES_PER_LISTING=5

# AI Assistant Configuration
# Set to 'mock' or 'gemini' or 'none'
AI_PROVIDER=mock
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-1.5-flash

# Frontend Configuration (for client/.env)
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
# VITE_FIREBASE_API_KEY=your_firebase_web_api_key
# VITE_FIREBASE_AUTH_DOMAIN=campusbid-prod.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=campusbid-prod
# VITE_FIREBASE_STORAGE_BUCKET=campusbid-prod.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
